# Copy to .env at the repo root.
#
# Runtime/bootstrap config stays in env — everything else is configured in
# /admin/settings and stored encrypted in the database (AES-GCM with a key
# derived from JWT_SECRET).

DATABASE_URL="postgresql://printingcomics:dev_password_change_me@localhost:5432/printingcomics?schema=public"

# Server
PORT=4000
JWT_SECRET="change-me-to-a-long-random-string"
SESSION_COOKIE_NAME="pc_session"
NODE_ENV=development

# Frontend origin for CORS (comma-separated for multiple)
WEB_ORIGIN="http://localhost:5173"

# PayPal return/cancel URLs used in the Orders v2 experience_context.
PAYPAL_RETURN_URL="http://localhost:5173/checkout/paypal/return"
PAYPAL_CANCEL_URL="http://localhost:5173/checkout"

# Uploads directory for email attachments
UPLOADS_DIR="./uploads"

# Bot blocker — path the host-side watcher service polls to apply iptables.
BOTBLOCK_PENDING_FILE="/tmp/botblock-pending"

# Admin bootstrap (created by seed)
ADMIN_EMAIL="admin@printingcomics.com"
ADMIN_PASSWORD="changeme"

# Optional bootstrap values — everything below is overridden by /admin/settings.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
BREVO_API_KEY=""
BREVO_FROM_EMAIL=""
BREVO_FROM_NAME="Printing Comics"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-4-7"
