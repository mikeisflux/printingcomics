# Application identity
VITE_APP_ENV=development
VITE_APP_URL=http://localhost:5173

# Supabase values that are safe to expose to the browser when Row Level
# Security is correctly enabled. Use different values in every environment.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Final safety switch. Leave false until staging migrations, role tests, and
# page-by-page data conversion have passed. Demo Access always remains local.
VITE_USE_SUPABASE_BACKEND=false

# Keep "mock" while developing with demo accounts. Change to "supabase" only
# after real Auth users and their Philbo roles have been provisioned.
VITE_AUTH_PROVIDER=mock

# Server-only Supabase secret. Never prefix this with VITE_ and never use it
# from React/browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Enable only after the migration, both Edge Functions, Stripe secrets, and a
# signed test-mode webhook have passed end-to-end on staging.
VITE_ENABLE_PAYMENTS=false
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PHILBO_SITE_URL=
PHILBO_ALLOWED_ORIGINS=

# Server-only Google Drive archive configuration. Never prefix credentials
# with VITE_ or include them in the browser bundle.
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_PUBLIC_FOLDER_ID=
GOOGLE_DRIVE_PRIVATE_FOLDER_ID=
GOOGLE_DRIVE_OPERATIONS_FOLDER_ID=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
