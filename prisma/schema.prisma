// Printing Comics storefront schema.
generator client {
  provider             = "prisma-client"
  output               = "../server/src/generated/prisma"
  runtime              = "nodejs"
  moduleFormat         = "esm"
  importFileExtension  = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  IN_PRODUCTION
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum PartnerStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum PartnerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  firstName    String?
  lastName     String?
  phone        String?
  role         Role      @default(CUSTOMER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // When set, this user is a "partner contact" — staff at a crowdfunding
  // platform / publisher who can be CC'd on order emails and (in future)
  // log into a partner dashboard. Independent of the Role enum.
  partner   Partner? @relation("PartnerMembers", fields: [partnerId], references: [id])
  partnerId String?

  addresses              Address[]
  orders                 Order[]
  carts                  Cart[]
  mediaUploads           MediaFile[]
  passwordResets         PasswordReset[]
  apiKeysCreated         ApiKey[]             @relation("ApiKeyCreator")
  partnersCreated        Partner[]            @relation("PartnerCreator")
  applicationsReviewed   PartnerApplication[] @relation("ApplicationReviewer")
  projectsCreated        PartnerProject[]     @relation("ProjectCreator")

  @@index([partnerId])
}

// Single-use password reset tokens. tokenHash is sha256(rawToken) so
// even DB access doesn't leak a working reset link.
model PasswordReset {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Address {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  label      String?
  firstName  String
  lastName   String
  company    String?
  line1      String
  line2      String?
  city       String
  region     String
  postalCode String
  country    String   @default("US")
  phone      String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId])
}

model Category {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?
  heroImageUrl String?
  iconUrl     String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  parentId    String?
  children    Category[] @relation("CategoryTree")
  sortOrder   Int        @default(0)
  products    ProductCategory[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Product {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  shortDescription String?
  description     String?
  // Base price in cents (USD). Variants can override.
  priceCents      Int      @default(0)
  // If true, show variant price range instead of base price.
  hasVariants     Boolean  @default(false)
  sku             String?  @unique
  stock           Int      @default(0)
  // True for custom-print products where stock is not tracked.
  madeToOrder     Boolean  @default(false)
  active          Boolean  @default(true)
  minQuantity     Int      @default(1)
  weightGrams     Int      @default(0)
  // Tier-based volume discounts: JSON array of { minQty, pricePerUnitCents }.
  volumeTiers     Json?
  // PDF print template the buyer downloads before uploading artwork.
  templateUrl     String?
  // Array of { q, a } rendered as an accordion on the product page.
  faq             Json?
  // Structured pricing rules the storefront + server both use to compute
  // unit price from configurator selections. Shape: { baseCents,
  // qtyTiers[], modifiers[], pages: { tiers{}, colorKey, paperKey,
  // pagesKey } }. See server/src/lib/pricing.ts.
  pricingConfig   Json?
  seoTitle        String?
  seoDescription  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  categories      ProductCategory[]
  images          ProductImage[]
  variants        ProductVariant[]
  options         ProductOption[]
  orderItems      OrderItem[]
  cartItems       CartItem[]
  seoAnalysis     SeoAnalysis?
}

model ProductCategory {
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String

  @@id([productId, categoryId])
  @@index([categoryId])
}

model ProductImage {
  id        String  @id @default(cuid())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)

  @@index([productId])
}

enum ProductOptionType {
  TILES     // Image grid (cover paper, interior paper)
  RADIO     // Inline buttons (Yes / No)
  SELECT    // Dropdown (interior pages)
  TOGGLE    // Boolean switch (is reorder)
  TEXT      // Free text (title of comic)
  NUMBER    // Numeric (page count)
  UPLOAD    // File upload to media library
  CONFIRM   // Required acknowledgement checkbox
}

// Configurable option on a product. Options are grouped into "sections"
// (Your Cover, Your Pages, Finalize Setup) and can be made conditionally
// visible by another option's selected value.
model ProductOption {
  id          String               @id @default(cuid())
  product     Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   String
  name        String
  // Stable key written into cart/order options JSON; defaults to a slugified
  // version of `name` if blank.
  internalKey String?
  // Display grouping — free-text label shown as the section title.
  section     String?
  type        ProductOptionType    @default(SELECT)
  required    Boolean              @default(false)
  helpText    String?
  // Description shown under the full prompt, e.g. the long "I confirm" body.
  longDescription String?
  sortOrder   Int                  @default(0)

  // Conditional visibility: only show this option when the option with
  // id = dependsOnOptionId has its selected value = dependsOnValue.
  dependsOnOptionId String?
  dependsOnOption   ProductOption?  @relation("OptionDep", fields: [dependsOnOptionId], references: [id])
  dependents        ProductOption[] @relation("OptionDep")
  dependsOnValue    String?

  values      ProductOptionValue[]

  @@index([productId])
}

model ProductOptionValue {
  id            String        @id @default(cuid())
  option        ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  optionId      String
  label         String
  // Secondary small text shown under the label (e.g. "80lb Uncoated Cover").
  subLabel      String?
  // Thumbnail image for TILES-type options.
  imageUrl      String?
  priceModifierCents Int      @default(0)
  sortOrder     Int           @default(0)

  @@index([optionId])
}

// A specific variant SKU (e.g. page count 48, soft cover).
model ProductVariant {
  id         String   @id @default(cuid())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  sku        String?  @unique
  // Human-readable label like "48pg / Soft Cover".
  label      String
  priceCents Int
  stock      Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
}

model Cart {
  id         String     @id @default(cuid())
  // Null if guest cart; linked by sessionToken cookie.
  user       User?      @relation(fields: [userId], references: [id])
  userId     String?
  sessionKey String?    @unique
  items      CartItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([userId])
}

model CartItem {
  id         String          @id @default(cuid())
  cart       Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId     String
  product    Product         @relation(fields: [productId], references: [id])
  productId  String
  variant    ProductVariant? @relation(fields: [variantId], references: [id])
  variantId  String?
  quantity   Int
  // Snapshot selected options JSON, e.g. { "Page Count": "48", ... }.
  options    Json?
  // Unit price at add-to-cart time, after variant/option/volume adjustments.
  unitPriceCents Int
  createdAt  DateTime        @default(now())

  @@index([cartId])
  @@index([productId])
}

model Order {
  id              String        @id @default(cuid())
  number          String        @unique
  user            User?         @relation(fields: [userId], references: [id])
  userId          String?
  email           String
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)

  subtotalCents   Int
  shippingCents   Int           @default(0)
  taxCents        Int           @default(0)
  discountCents   Int           @default(0)
  totalCents      Int

  shippingAddress Json
  billingAddress  Json
  // Latest shipment's carrier+service, for the customer-facing summary and
  // shipping-notification email. See the Shipment table for the full list —
  // an order can have multiple shipments when split across boxes.
  shippingMethod  String?
  trackingNumber  String?
  notes           String?

  // Proofing workflow (see Proof / MediaRequest). null = no proof required;
  // otherwise "awaiting_upload" | "awaiting_approval" | "approved" |
  // "changes_requested". Orders are hard-blocked from production/shipping
  // while a proof is required and not yet approved.
  proofStatus     String?

  items           OrderItem[]
  payments        Payment[]
  events          OrderStatusEvent[]
  review          Review?
  shipments       Shipment[]
  proofs          Proof[]
  mediaRequests   MediaRequest[]

  // API integration: orders submitted by an external integrator (e.g. a
  // crowdfunding platform) carry the ApiKey that created them and an
  // optional externalRef (their pledge / order id) for idempotency.
  source          String?       // "web" | "api"
  apiKey          ApiKey?       @relation(fields: [apiKeyId], references: [id])
  apiKeyId        String?
  // Denormalized off the apiKey at create-time so admin queries grouping by
  // partner stay fast even when keys get rotated/revoked.
  partner         Partner?      @relation(fields: [partnerId], references: [id])
  partnerId       String?
  // Optional link to the campaign this print run is for — required when an
  // API order specifies a `projectId`. One project can carry multiple orders
  // (re-prints, expansions, etc.).
  project         PartnerProject? @relation(fields: [projectId], references: [id])
  projectId       String?
  externalRef     String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([apiKeyId, externalRef])
  @@index([userId])
  @@index([status])
  @@index([apiKeyId])
  @@index([partnerId])
  @@index([projectId])
}

// API keys for third-party integrations (crowdfunding platforms, etc.) to
// submit orders programmatically. The full key is shown exactly once at
// creation time; the database stores only the SHA-256 hash and a short
// prefix for identification.
model ApiKey {
  id          String    @id @default(cuid())
  name        String
  prefix      String    @unique
  keyHash     String    @unique
  scopes      String[]  @default([])
  active      Boolean   @default(true)
  lastUsedAt  DateTime?
  // Soft rate-limit ceiling per minute (null = use global default).
  rateLimitPerMinute Int?
  notes       String?
  createdAt   DateTime  @default(now())
  createdById String?
  createdBy   User?     @relation("ApiKeyCreator", fields: [createdById], references: [id])
  revokedAt   DateTime?

  // Optional partner this key belongs to. Pre-existing keys may be unattached;
  // newly minted keys via /admin/partners/:id/api-keys are always attached.
  partner     Partner?  @relation(fields: [partnerId], references: [id])
  partnerId   String?

  // HMAC signing secret paired with this key. Stored AES-GCM encrypted; the
  // plaintext is only ever returned at mint time (and can be rotated). The
  // integrator uses it to sign request bodies with X-PC-Request-Signature
  // when `requireRequestSigning` is on, the server rejects unsigned writes.
  signingSecretEncrypted String?
  requireRequestSigning  Boolean   @default(false)

  orders      Order[]
  uploads     MediaFile[]

  @@index([keyHash])
  @@index([prefix])
  @@index([partnerId])
}

// First-class record of a third-party platform that submits print orders
// (Kickstarter campaigns, Indiegogo, BackerKit, Gamefound, publishers, etc.).
// A partner groups one or more ApiKeys, owns the orders submitted by them,
// and configures a webhook + status that gates all API access.
model Partner {
  id           String        @id @default(cuid())
  slug         String        @unique
  name         String
  // Free-form platform tag — "kickstarter", "indiegogo", "backerkit",
  // "gamefound", "publisher", "other". Drives icons + filters in the admin UI.
  platform     String?
  contactEmail String?
  contactName  String?
  website      String?
  status       PartnerStatus @default(ACTIVE)
  notes        String?
  // CSS color tag used to color-code the partner in lists/badges. e.g. "#1e74fc".
  color        String?

  // Outbound webhook config — we POST signed payloads to webhookUrl on
  // status changes (paid, in production, shipped, delivered, cancelled).
  webhookUrl    String?
  webhookSecret String?

  // Soft caps that the suspend logic + per-partner rate limiter consult.
  rateLimitPerMinute Int?
  monthlyOrderCap    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy   User?   @relation("PartnerCreator", fields: [createdById], references: [id])
  createdById String?

  apiKeys           ApiKey[]
  orders            Order[]
  members           User[]                   @relation("PartnerMembers")
  webhookDeliveries PartnerWebhookDelivery[]
  events            PartnerEvent[]
  applications      PartnerApplication[]
  uploads           MediaFile[]
  projects          PartnerProject[]

  @@index([status])
  @@index([platform])
}

// Append-only log of webhook delivery attempts so the admin can audit which
// events fired, whether they reached the partner, and replay failures.
model PartnerWebhookDelivery {
  id           String    @id @default(cuid())
  partner      Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerId    String
  event        String
  orderId      String?
  url          String
  payload      Json
  attempts     Int       @default(0)
  statusCode   Int?
  responseBody String?
  error        String?
  succeeded    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  deliveredAt  DateTime?
  nextRetryAt  DateTime?

  @@index([partnerId])
  @@index([event])
  @@index([createdAt])
  @@index([succeeded])
}

// Lightweight activity feed: who changed what about a partner. Distinct from
// webhook deliveries — those are outbound HTTP attempts, this is an in-app log.
// A creator's project / campaign on a partner platform — e.g. one
// Kickstarter campaign run by one creator. Partners may have many; each
// project carries the platform-side id so re-submitting a print order for
// the same campaign upserts onto the same row.
model PartnerProject {
  id                String   @id @default(cuid())
  partner           Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerId         String
  // The platform's id for this project — Kickstarter project slug,
  // Indiegogo campaign id, BackerKit shop id, etc. Unique within a partner.
  externalProjectId String
  title             String
  url               String?
  // Creator running this campaign — free-form so partners don't have to
  // pre-register users. Optionally linked to a real User account for portal
  // access (future).
  creatorName       String?
  creatorEmail      String?
  creatorUserId     String?
  creatorUser       User?    @relation("ProjectCreator", fields: [creatorUserId], references: [id])
  // "active" | "completed" | "cancelled" — admin-side workflow tag.
  status            String   @default("active")
  notes             String?
  metadata          Json?    // Free-form bag for whatever the partner wants to stash
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  orders Order[]

  @@unique([partnerId, externalProjectId])
  @@index([partnerId])
  @@index([creatorEmail])
  @@index([creatorUserId])
  @@index([status])
}

model PartnerEvent {
  id        String   @id @default(cuid())
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerId String
  kind      String   // "created" | "updated" | "suspended" | "restored" | "key_minted" | "key_revoked" | "webhook_test" | "member_added" | "member_removed" | "note"
  message   String?
  actorId   String?
  actorName String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([partnerId])
  @@index([createdAt])
}

// Inbound self-service requests submitted from /developers. Reviewed by an
// admin; approval mints a Partner + first API key and emails the requester.
model PartnerApplication {
  id                     String                   @id @default(cuid())
  name                   String                   // partner / project / campaign name
  contactName            String
  contactEmail           String
  platform               String?
  website                String?
  scopes                 String[]                 @default([])
  estimatedMonthlyOrders Int?
  message                String?
  status                 PartnerApplicationStatus @default(PENDING)
  reviewer               User?                    @relation("ApplicationReviewer", fields: [reviewerId], references: [id])
  reviewerId             String?
  reviewNotes            String?
  partner                Partner?                 @relation(fields: [partnerId], references: [id])
  partnerId              String?
  ipAddress              String?
  userAgent              String?
  createdAt              DateTime                 @default(now())
  reviewedAt             DateTime?

  @@index([status])
  @@index([createdAt])
  @@index([contactEmail])
}

// Append-only log of order status / payment / tracking changes. Lets the
// admin and the customer both see when each transition happened and
// optionally who made the change (null actor = automated).
model OrderStatusEvent {
  id         String   @id @default(cuid())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String
  fromStatus String?
  toStatus   String?
  kind       String   // "status" | "payment" | "tracking" | "note" | "email" | "fulfillment"
  message    String?
  actorId    String?
  actorName  String?
  createdAt  DateTime @default(now())

  @@index([orderId])
}

// Available shipping containers the fulfillment team can use. Drives the
// ShipStation rate-quote API (which needs dimensions + weight to price)
// and the per-order packing slip.
model Package {
  id            String   @id @default(cuid())
  name          String   // "Small mailer", "Comic flat", "Box 10×10×6", etc.
  description   String?
  // Inner dimensions in inches.
  lengthIn      Float
  widthIn       Float
  heightIn      Float
  // Empty package weight in ounces (added to product weight at quote time).
  emptyWeightOz Float    @default(0)
  // Optional max packed weight (ounces).
  maxWeightOz   Float?
  // Optional cost per package, for cost accounting.
  costCents     Int      @default(0)
  // True for the system default. Only one Package should have isDefault=true.
  isDefault     Boolean  @default(false)
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shipments     Shipment[]
}

model OrderItem {
  id         String          @id @default(cuid())
  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String
  product    Product         @relation(fields: [productId], references: [id])
  productId  String
  variant    ProductVariant? @relation(fields: [variantId], references: [id])
  variantId  String?
  name       String
  options    Json?
  quantity   Int
  unitPriceCents Int
  totalCents Int

  shipmentItems ShipmentItem[]
  files         OrderItemFile[]
  proofs        Proof[]

  @@index([orderId])
}

// Print files attached to an order line item — covers, interior PDFs, dust
// jackets, etc. A line item can have any number; `purpose` is free-form so
// new product types don't require a schema migration. The MediaFile carries
// the actual storage details + tagging.
model OrderItemFile {
  id          String    @id @default(cuid())
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  orderItemId String
  media       MediaFile @relation(fields: [mediaFileId], references: [id])
  mediaFileId String
  // e.g. "cover", "interior", "back-cover", "spot-uv", "dust-jacket", "other".
  purpose     String?
  notes       String?
  createdAt   DateTime  @default(now())

  @@index([orderItemId])
  @@index([mediaFileId])
}

// A PDF proof uploaded by staff for the customer to approve before production.
// Proofs are per order ITEM (and per kind — books need a cover proof and an
// interior proof; prints a single artwork proof), each independently versioned
// after change requests. The order cannot move into production/shipping until
// every required proof slot's latest version is approved. Legacy rows have
// orderItemId/kind null (one order-level proof).
model Proof {
  id              String     @id @default(cuid())
  order           Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId         String
  orderItem       OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  orderItemId     String?
  // "cover" | "interior" (books) or "artwork" (prints & everything else).
  kind            String?
  media           MediaFile  @relation(fields: [mediaFileId], references: [id])
  mediaFileId     String
  version         Int       @default(1)
  status          String    @default("pending") // "pending" | "approved" | "changes_requested"
  // Random, unguessable token for the customer's no-login review link.
  token           String    @unique
  message         String?   // optional note staff show the customer with the proof
  decisionNote    String?   // the customer's note when requesting changes
  approvedName    String?   // name the customer typed when approving
  approvedTermsAt DateTime? // when the customer accepted the approval terms
  decidedAt       DateTime?
  createdAt       DateTime  @default(now())

  @@index([orderId])
  @@index([orderItemId])
}

// A customer review, solicited automatically once an order is delivered.
// Created in `invited` state with an unguessable token so the customer can
// leave feedback from an email link with no account. Nothing appears on the
// storefront until staff approve it.
model Review {
  id           String    @id @default(cuid())
  order        Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId      String?   @unique
  email        String
  // Display name the customer chose; falls back to the order name.
  customerName String?
  rating       Int?      // 1–5, set on submission
  title        String?
  body         String?
  // "invited"  — request emailed, not yet filled in
  // "pending"  — submitted, awaiting moderation
  // "approved" — live on the storefront
  // "rejected" — hidden; keeps the row so we don't re-solicit
  status       String    @default("invited")
  token        String    @unique
  // Pin to the front of the storefront slider.
  featured     Boolean   @default(false)
  sortOrder    Int       @default(0)
  // Optional public reply from the shop.
  reply        String?
  adminNote    String?   // internal only, never shown publicly
  requestedAt  DateTime  @default(now())
  submittedAt  DateTime?
  decidedAt    DateTime?
  decidedById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([email])
}

// A staff request for the customer to (re-)upload corrected artwork. Emails the
// customer a tokenized return link; uploaded files attach back to the order.
model MediaRequest {
  id          String    @id @default(cuid())
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  message     String
  token       String    @unique
  status      String    @default("open") // "open" | "fulfilled"
  fulfilledAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([orderId])
}

// A physical box going out for an order. Orders may require multiple
// shipments when contents don't fit in one parcel; each shipment tracks its
// own EasyPost label, carrier, tracking code, and insurance policy. The
// insured value is the sum of the allocated items' price × quantity — never
// the order total — so a $400 order split 3 ways insures each box for only
// what's physically in it.
model Shipment {
  id               String   @id @default(cuid())
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId          String
  package          Package? @relation(fields: [packageId], references: [id])
  packageId        String?

  // EasyPost correlation. easypostId is set as soon as /rates is called;
  // the rest populate once /buy succeeds.
  easypostId       String?  @unique
  trackingCode     String?
  carrier          String?
  service          String?
  labelUrl         String?
  rateAmountCents  Int?     // postage paid, cents
  insuredValueCents Int?    // declared value sent to Shipsurance via EasyPost
  insuranceFeeCents Int?    // what EasyPost billed for the insurance leg

  // Snapshot of the parcel at buy time — keeps things reproducible even if
  // the Package template is later edited.
  weightOz   Float?
  lengthIn   Float?
  widthIn    Float?
  heightIn   Float?

  // CREATED → PURCHASED → IN_TRANSIT → DELIVERED. Terminal: REFUNDED / VOIDED.
  status     String   @default("CREATED")

  items      ShipmentItem[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([orderId])
  @@index([easypostId])
}

// Which OrderItems (and how many of each) went into a given Shipment.
// quantity is bounded by the OrderItem.quantity; the sum of ShipmentItem
// quantities across shipments for one OrderItem should equal OrderItem.quantity
// once the order is fully packed.
model ShipmentItem {
  id          String    @id @default(cuid())
  shipment    Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  shipmentId  String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  orderItemId String
  quantity    Int

  @@index([shipmentId])
  @@index([orderItemId])
}

model Payment {
  id              String        @id @default(cuid())
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId         String
  provider        String        @default("paypal")
  providerRef     String?
  amountCents     Int
  status          PaymentStatus @default(PENDING)
  rawPayload      Json?
  createdAt       DateTime      @default(now())

  @@index([orderId])
  @@index([providerRef])
}

model ShippingZone {
  id        String         @id @default(cuid())
  name      String
  countries String[]
  rates     ShippingRate[]
  createdAt DateTime       @default(now())
}

model ShippingRate {
  id               String       @id @default(cuid())
  zone             ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  zoneId           String
  name             String
  // Flat rate in cents OR per-kg in cents (when perKg is true).
  rateCents        Int
  perKg            Boolean      @default(false)
  minSubtotalCents Int          @default(0)
  maxSubtotalCents Int?
  estimatedDays    String?

  @@index([zoneId])
}

model TaxRate {
  id        String   @id @default(cuid())
  name      String
  region    String
  country   String   @default("US")
  rateBps   Int // basis points: 825 = 8.25%
  createdAt DateTime @default(now())
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  description    String?
  // Either percent off (bps) or fixed amount off (cents).
  percentOffBps  Int?
  amountOffCents Int?
  minSubtotalCents Int    @default(0)
  usageLimit     Int?
  usageCount     Int      @default(0)
  expiresAt      DateTime?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
}

model Setting {
  key        String   @id
  value      Json
  // If true, `value` is AES-GCM encrypted ciphertext stored as hex "iv:ct:tag".
  encrypted  Boolean  @default(false)
  updatedAt  DateTime @updatedAt
}

// ============================================================
// Media Library (ported patterns from indiecrowdfund_2.0 /admin/media)
// ============================================================

model MediaFile {
  id           String   @id @default(cuid())
  filename     String   @unique // storage key on disk (randomized)
  originalName String
  mimeType     String
  size         Int
  url          String   // public URL (starts with /uploads/)
  thumbnailUrl String?
  width        Int?
  height       Int?
  duration     Int?     // seconds, for video/audio
  folder       String   @default("/") // flat virtual hierarchy — use "/subfolder" strings
  tags         String[]
  altText      String?
  uploaderId   String?
  uploader     User?    @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  // When uploaded via the public /api/v1/uploads endpoint, attribute back to
  // the originating partner + key so admins can audit and the partner can
  // list their own uploads.
  partnerId    String?
  partner      Partner? @relation(fields: [partnerId], references: [id])
  apiKeyId     String?
  apiKey       ApiKey?  @relation(fields: [apiKeyId], references: [id])
  // SHA-256 of the file contents. Lets us detect identical re-uploads and
  // gives partners something stable to log.
  contentHash  String?
  // sha256(filename + JWT_SECRET) — used to gate /uploads/* downloads behind
  // a token so a leaked filename alone can't be enumerated.
  accessToken  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orderItemFiles OrderItemFile[]
  proofs         Proof[]

  @@index([folder])
  @@index([mimeType])
  @@index([createdAt])
  @@index([partnerId])
  @@index([apiKeyId])
  @@index([contentHash])
}

// ============================================================
// Bot blocker (ported from indiecrowdfund_2.0)
// ============================================================

model BlockedIP {
  ipAddress      String   @id
  reason         String
  violationCount Int      @default(1)
  blockedAt      DateTime @default(now())
  expiresAt      DateTime
  lastUserAgent  String?
  lastPath       String?
  lastActionId   String?

  @@index([expiresAt])
}

model SuspiciousActivity {
  id         String   @id @default(cuid())
  ipAddress  String
  reason     String
  actionId   String?
  path       String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([ipAddress, createdAt])
  @@index([createdAt])
}

// ============================================================
// SEO (Claude-powered)
// ============================================================

enum SeoStatus {
  PENDING
  COMPLETE
  FAILED
}

model SeoAnalysis {
  id              String    @id @default(cuid())
  product         Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId       String?   @unique
  // Page target (when not a product).
  pageUrl         String?
  status          SeoStatus @default(PENDING)
  score           Int?
  suggestedTitle  String?
  suggestedDescription String?
  headline        String?
  summary         String?
  issues          Json?     // [{ severity, message, field }]
  rewrittenBody   String?
  keywords        SeoKeyword[]
  tokensUsed      Int       @default(0)
  modelUsed       String?
  errorMessage    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model SeoKeyword {
  id           String      @id @default(cuid())
  analysis     SeoAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  analysisId   String
  keyword      String
  intent       String?     // informational, commercial, transactional, navigational
  difficulty   Int?        // 0-100 from Claude's estimate
  relevance    Int?        // 0-100
  createdAt    DateTime    @default(now())

  @@index([analysisId])
}

// ============================================================
// Email (SendGrid + CRUD)
// ============================================================

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
  CANCELLED
}

enum EmailSendStatus {
  QUEUED
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  FAILED
  UNSUBSCRIBED
}

model EmailTemplate {
  id           String   @id @default(cuid())
  name         String
  subject      String
  html         String
  text         String?
  // Free-form placeholder docs, e.g. {{first_name}}
  variables    Json?
  archived     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  campaigns    EmailCampaign[]
}

model EmailSubscriber {
  id          String   @id @default(cuid())
  email       String   @unique
  firstName   String?
  lastName    String?
  optedIn     Boolean  @default(true)
  unsubscribedAt DateTime?
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lists       EmailListMember[]
  sends       EmailSend[]
}

model EmailList {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  members     EmailListMember[]
  campaigns   EmailCampaign[]
}

model EmailListMember {
  list         EmailList       @relation(fields: [listId], references: [id], onDelete: Cascade)
  listId       String
  subscriber   EmailSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  subscriberId String
  addedAt      DateTime        @default(now())

  @@id([listId, subscriberId])
  @@index([subscriberId])
}

model EmailCampaign {
  id              String          @id @default(cuid())
  name            String
  subject         String
  fromName        String?
  fromEmail       String?
  replyTo         String?
  html            String
  text            String?
  template        EmailTemplate?  @relation(fields: [templateId], references: [id])
  templateId      String?
  list            EmailList?      @relation(fields: [listId], references: [id])
  listId          String?
  // Optional: list of subscriber ids beyond the list (e.g. manual picks).
  extraRecipients String[]
  scheduledAt     DateTime?
  sentAt          DateTime?
  status          CampaignStatus  @default(DRAFT)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  attachments     EmailAttachment[]
  sends           EmailSend[]
}

model EmailAttachment {
  id          String        @id @default(cuid())
  campaign    EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId  String
  filename    String
  contentType String
  sizeBytes   Int
  storageKey  String        // path relative to UPLOADS_DIR
  createdAt   DateTime      @default(now())

  @@index([campaignId])
}

model EmailSend {
  id            String          @id @default(cuid())
  campaign      EmailCampaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  campaignId    String?
  subscriber    EmailSubscriber? @relation(fields: [subscriberId], references: [id], onDelete: SetNull)
  subscriberId  String?
  toEmail       String
  subject       String
  status        EmailSendStatus @default(QUEUED)
  providerRef   String?         // SendGrid x-message-id
  openedAt      DateTime?
  clickedAt     DateTime?
  errorMessage  String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([campaignId])
  @@index([subscriberId])
  @@index([status])
  @@index([providerRef])
}

// Incoming email delivered by Mailgun Routes → /api/webhooks/mailgun/inbound.
// Replies thread back to our outbound sends by matching inReplyTo against
// EmailSend.providerRef (Mailgun's message-id we stored on send).
model InboundEmail {
  id             String   @id @default(cuid())
  messageId      String?  @unique
  inReplyTo      String?
  fromEmail      String
  fromName       String?
  toEmail        String
  subject        String
  textBody       String?
  strippedText   String?  // Mailgun's auto-stripped "just the new reply" text
  htmlBody       String?
  rawHeaders     Json?
  attachments    Json?    // [{ filename, url, size, contentType }]
  kind           String   @default("inbound")  // "inbound" | "bounce" | "complaint"
  bounceType     String?  // "hard" | "soft" | null
  linkedSendId   String?
  handled        Boolean  @default(false)
  receivedAt     DateTime @default(now())

  @@index([receivedAt])
  @@index([kind])
  @@index([fromEmail])
  @@index([inReplyTo])
}
