node_modules/
dist/
build/
.env
.env.local
.env.*.local
*.log
.DS_Store
.vite/
coverage/
prisma/migrations/dev.db*
siteold/db_tables/wp_options.sql

# Generated Prisma client (recreated on every install via postinstall)
server/src/generated/

# The imposition-toolkit plugin ships a pre-built ESM bundle in its dist/ —
# keep it tracked despite the global dist/ ignore above.
!plugins/imposition-toolkit/dist/
!plugins/imposition-toolkit/dist/**

# Per-server deploy bookkeeping written by scripts/deploy.sh (what was last installed/pushed/seeded).
.deploy-state

# Runtime upload storage (customer files, proofs) — never source. The API
# writes here relative to its working directory (UPLOADS_DIR), so both the
# repo root and server/ are covered.
/uploads/
/server/uploads/
