{
  "name": "printingcomics",
  "private": true,
  "version": "0.1.0",
  "description": "Self-hosted storefront + admin for Printing Comics",
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "npm-run-all -p dev:server dev:web",
    "dev:server": "npm --workspace server run dev",
    "dev:web": "npm --workspace web run dev",
    "build": "prisma generate && npm --workspace server run build && npm --workspace web run build",
    "start": "npm --workspace server run start",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:cws": "tsx prisma/seed-cws.ts",
    "db:reset": "prisma migrate reset"
  },
  "overrides": {
    "@hono/node-server": "^1.19.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "npm-run-all": "^4.1.5",
    "prisma": "^7.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "pg": "^8.13.1"
  }
}
